<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Survey Redirect</title>
</head>
<body>
<script>
(function () {
  // ====== 設定（ここだけ編集）======
  const URL_A = "https://forms.office.com/Pages/ResponsePage.aspx?id=XXXX_A";
  const URL_B = "https://forms.office.com/Pages/ResponsePage.aspx?id=XXXX_B";
  const COOKIE_NAME = "ab_variant";
  const COOKIE_DAYS = 120; // 調査期間より長く
  const P_A = 0.5; // Aの割合（0.5=50/50）
  // =================================

  function getCookie(name) {
    const m = document.cookie.match(new RegExp("(?:^|; )" + name.replace(/([.$?*|{}()[\]\\/+^])/g, "\\$1") + "=([^;]*)"));
    return m ? decodeURIComponent(m[1]) : null;
  }

  function setCookie(name, value, days) {
    const expires = new Date(Date.now() + days * 864e5).toUTCString();
    document.cookie = `${name}=${encodeURIComponent(value)}; expires=${expires}; path=/; SameSite=Lax`;
  }

  let v = getCookie(COOKIE_NAME);

  if (v !== "A" && v !== "B") {
    v = (Math.random() < P_A) ? "A" : "B";
    setCookie(COOKIE_NAME, v, COOKIE_DAYS);
  }

  const target = (v === "A") ? URL_A : URL_B;
  window.location.replace(target);
})();
</script>

<noscript>
  JavaScriptが無効のため自動振り分けできません。JavaScriptを有効にして再度アクセスしてください。
</noscript>
</body>
</html>
